# Copy to .env (git-ignored) and export before running: set -a; source .env; set +a
SECRET_KEY=change-me            # generate with: openssl rand -hex 32
DATABASE_URL=postgresql://user:password@localhost/TodoApplicationDatabase
# Swagger/ReDoc/OpenAPI are disabled unless this is true (leave it off in production)
ENABLE_DOCS=false
# The session cookie is HttpOnly + Secure (HTTPS only). Set false ONLY for local http development.
COOKIE_SECURE=false
# Extra hosts allowed to send cross-origin writes (comma-separated host[:port]); usually empty.
ALLOWED_ORIGIN_HOSTS=
